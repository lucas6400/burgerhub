# Banco de dados PostgreSQL (Neon)
# DATABASE_URL: conexão via pooler (pgbouncer) — usada em runtime.
# DATABASE_URL_UNPOOLED: conexão direta — usada por `prisma db push` / `migrate`.
# Se o provedor só der uma URL, use o mesmo valor nas duas.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require&pgbouncer=true"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

JWT_SECRET="troque-por-um-segredo-forte-em-producao"
PORT=3333

# URLs públicas (usadas para gerar links e webhooks corretos em produção)
PUBLIC_API_URL="https://seu-projeto-api.vercel.app"
PUBLIC_WEB_URL="https://seu-projeto-web.vercel.app"

# --- WhatsApp (infraestrutura da plataforma — o lojista nunca vê isso) ---
WA_SERVER_URL=""
WA_SERVER_KEY=""
# Demo sem servidor real (simula o fluxo de conexão):
WA_MOCK=true

# --- Pagamentos online (Mercado Pago) ---
# O Access Token é POR ESTABELECIMENTO (configurado no painel de cada um).
# MP_MOCK=true simula Pix/cartão sem conta real:
MP_MOCK=true

# --- Upload de imagem (Vercel Blob) ---
# Gere com `vercel blob create-store <nome> --access public --yes` dentro de apps/api
# (linka automaticamente ao projeto e já baixa o token pro .env.local).
BLOB_READ_WRITE_TOKEN=""

# --- Notificação push (Web Push) — avisa o staff de pedido novo mesmo com o
# painel fechado. Gere o par uma única vez com `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@burgerhub.app"

# --- IA (Claude/Anthropic) — conduz a conversa do bot no modo IA (ai-conversation.service.ts) ---
# Sem essa chave, o bot cai no modo padrão (menu numerado), sem IA.
ANTHROPIC_API_KEY=""
# Opcional — troca de modelo sem precisar editar código. Sem definir, usa os
# valores abaixo (os mesmos já usados hoje).
ANTHROPIC_MODEL_HAIKU="claude-haiku-4-5"
ANTHROPIC_MODEL_SONNET="claude-sonnet-5"
# Opcional — fixa UM modelo pra decidir o pedido em todo turno. Deixe vazio/ausente para o modo automático:
# Sonnet só nas mensagens que mexem no carrinho, Haiku no resto (Sonnet em toda mensagem custa ~6x mais).
# ANTHROPIC_MODEL_EXECUTOR=""

# --- Transcrição de áudio do WhatsApp (Google Gemini) ---
# Sem essa chave, o bot só avisa que não consegue ouvir áudio.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
